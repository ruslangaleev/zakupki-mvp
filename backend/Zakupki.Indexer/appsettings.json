{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Indexer": {
    "DataPath": "../../data/orders",
    "OpenSearchUrl": "http://localhost:9200",
    "EmbeddingsUrl": "http://localhost:8090",
    "PollIntervalSeconds": 60,
    "EmbeddingDimensions": 384,
    "ChunkSize": 800,
    "ChunkOverlap": 120,
    "EmbedBatchSize": 16,
    "MaxChunksPerOrder": 80,
    "MinEmbedChunkChars": 80,
    "OrdersIndex": "zakupki-orders",
    "ChunksIndex": "zakupki-chunks"
  }
}
