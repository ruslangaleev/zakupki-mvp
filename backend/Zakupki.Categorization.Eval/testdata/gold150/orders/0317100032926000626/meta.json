    "\u0424\u0415\u0414\u0415\u0420\u0410\u041B\u042C\u041D\u041E\u0415 \u0413\u041E\u0421\u0423\u0414\u0410\u0420\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0415 \u0411\u042E\u0414\u0416\u0415\u0422\u041D\u041E\u0415 \u0423\u0427\u0420\u0415\u0416\u0414\u0415\u041D\u0418\u0415 \u0022\u0424\u0415\u0414\u0415\u0420\u0410\u041B\u042C\u041D\u042B\u0419 \u0426\u0415\u041D\u0422\u0420 \u0422\u0420\u0410\u0412\u041C\u0410\u0422\u041E\u041B\u041E\u0413\u0418\u0418, \u041E\u0420\u0422\u041E\u041F\u0415\u0414\u0418\u0418 \u0418 \u042D\u041D\u0414\u041E\u041F\u0420\u041E\u0422\u0415\u0417\u0418\u0420\u041E\u0412\u0410\u041D\u0418\u042F\u0022 \u041C\u0418\u041D\u0418\u0421\u0422\u0415\u0420\u0421\u0422\u0412\u0410 \u0417\u0414\u0420\u0410\u0412\u041E\u041E\u0425\u0420\u0410\u041D\u0415\u041D\u0418\u042F \u0420\u041E\u0421\u0421\u0418\u0419\u0421\u041A\u041E\u0419 \u0424\u0415\u0414\u0415\u0420\u0410\u0426\u0418\u0418 (\u0413. \u0411\u0410\u0420\u041D\u0410\u0423\u041B)": "12\u00A0000",
