    "\u041E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439 \u043E\u0431 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0435 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u0430": "\u041F\u0440\u0435\u043F\u0430\u0440\u0430\u0442 \u0437\u0430\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u0430\u043D\u0435\u0441\u0442\u0435\u0437\u0438\u0438, \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0439 \u043E\u0431\u044A\u0435\u043C \u043F\u0440\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B \u2013 2\u043C\u043B",
    "\u041D\u0430\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u0430": "\u041B\u0418\u0414\u041E\u041A\u0410\u0418\u041D, \u0420\u0410\u0421\u0422\u0412\u041E\u0420 \u0414\u041B\u042F \u0418\u041D\u042A\u0415\u041A\u0426\u0418\u0419 20 \u043C\u0433/\u043C\u043B, \u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0442\u043E\u0432\u0430\u0440\u0430: \u041A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440;^\u043C\u0438\u043B\u043B\u0438\u043B\u0438\u0442\u0440 (\u0441\u043C[3*];^\u043C\u043B), \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0444\u043E\u0440\u043C \u0432 \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u043E\u0439 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0435: 2 , \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u0442\u0440\u0435\u0431. \u0435\u0434\u0438\u043D\u0438\u0446 \u0432 \u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0435: 2\u00A0000",
    "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0444\u043E\u0440\u043C \u0432 \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u043E\u0439 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0435": "2",
