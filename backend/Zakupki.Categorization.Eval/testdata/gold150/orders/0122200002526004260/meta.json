440\u0430\u0439, \u0412\u0430\u043D\u0438\u043D\u0441\u043A\u0438\u0439 \u0440\u0430\u0439\u043E\u043D, \u0412\u0430\u043D\u0438\u043D\u043E \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u043F\u043E\u0441\u0435\u043B\u043E\u043A, \u041E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u0430\u044F \u0443\u043B\u0438\u0446\u0430, \u0434\u043E\u043C 27. \u0422\u0435\u043B\u0435\u0444\u043E\u043D: 7-42137-71034. \u0410\u0434\u0440\u0435\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u043F\u043E\u0447\u0442\u044B: zakaz.crb@gmail.com \u041E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u043B\u0438\u0446\u043E: \u041F\u043E\u0442\u0430\u043F\u043E\u0432\u0430 \u0422\u0430\u043C\u0430\u0440\u0430 \u0410\u043D\u0430\u0442\u043E\u043B\u044C\u0435\u0432\u043D\u0430,\u0410\u0434\u0440\u0435\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u043F\u043E\u0447\u0442\u044B \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430: priemcrbvanino@mail.ru, \u0422\u0435\u043B\u0435\u0444\u043E\u043D \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430: 7-42137-73623",
