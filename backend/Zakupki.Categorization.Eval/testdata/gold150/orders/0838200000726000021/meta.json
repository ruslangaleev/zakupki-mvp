    "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C": "1. \u0415\u0434\u0438\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C \u0437\u0430\u043A\u0443\u043F\u043E\u043A \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0447. 1 \u0441\u0442. 31 \u0417\u0430\u043A\u043E\u043D\u0430 \u2116 44-\u0424\u0417 2. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C \u0437\u0430\u043A\u0443\u043F\u043E\u043A \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0447. 1.1 \u0441\u0442. 31 \u0417\u0430\u043A\u043E\u043D\u0430 \u2116 44-\u0424\u0417 3. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C \u0437\u0430\u043A\u0443\u043F\u043E\u043A \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0447. 2 \u0441\u0442. 31 \u0417\u0430\u043A\u043E\u043D\u0430 \u2116 44-\u0424\u0417 3.1\u2003 \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u043F\u043E\u0437\u0438\u0446\u0438\u0435\u0439 34 \u0440\u0430\u0437\u0434\u0435\u043B\u0430 VI \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043A \u041F\u041F \u0420\u0424 \u043E\u0442 29.12.2021 \u2116 2571 \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u043E\u043F\u044B\u0442\u0430 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u0437\u0430\u043A\u0443\u043F\u043A\u0438 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430, \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E \u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u0443\u0441\u043B\u0443\u0433 \u043F\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044E \u043E\u0445\u0440\u0430\u043D\u044B \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 (\u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0439). \u0426\u0435\u043D\u0430 \u043E\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u0443\u0433 \u0434\u043E\u043B\u0436\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 20 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u043E\u0442 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 (\u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439) \u0446\u0435\u043D\u044B \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430, \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u043C\u043E\u0433\u043E \u043F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430 (\u043F\u043E\u0434\u0440\u044F\u0434\u0447\u0438\u043A\u0430, \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F). \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0449\u0438\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432 \u0437\u0430\u043A\u0443\u043F\u043A\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C: 1) \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0439 \u0434\u043E\u0433\u043E\u0432\u043E\u0440; 2) \u0430\u043A\u0442 \u043F\u0440\u0438\u0435\u043C\u043A\u0438 \u043E\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u0443\u0433, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0449\u0438\u0439 \u0446\u0435\u043D\u0443 \u043E\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u0443\u0433 4. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C \u0437\u0430\u043A\u0443\u043F\u043E\u043A \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u043F. 1 \u0447. 1 \u0441\u0442. 31 \u0417\u0430\u043A\u043E\u043D\u0430 \u2116 44-\u0424\u0417 \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u2022 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F (\u0432\u044B\u043F\u0438\u0441\u043A\u0438 \u0438\u0437 \u0440\u0435\u0435\u0441\u0442\u0440\u0430 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439) \u043D\u0430 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u043D\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 (\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E: \u0424\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u043C \u043E\u0442 04.05.2011 N 99-\u0424\u0417 (\u0440\u0435\u0434. \u043E\u0442 04.08.2026) \u0022\u041E \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0438\u0434\u043E\u0432 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438\u0022; \u0424\u0435\u0434\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u043C \u043E\u0442 30.11.2024 N 427-\u0424\u0417 \u0022\u041E \u0447\u0430\u0441\u0442\u043D\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438\u0022; \u041F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u0420\u0424 \u043E\u0442 23.06.2026 N 781 \u00AB\u041E\u0431 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0438 \u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043E \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438 \u0447\u0430\u0441\u0442\u043D\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438\u00BB)* \u0441 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0432\u0438\u0434\u043E\u0432 \u0443\u0441\u043B\u0443\u0433: \uF0FC \u043F\u0440\u0438\u0435\u043C, \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438, \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0435\u0439 \u0441 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043E\u0445\u0440\u0430\u043D\u044B, \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0435\u0435 \u0434\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u044B\u043C \u0433\u0440\u0443\u043F\u043F\u0430\u043C \u043E\u0445\u0440\u0430\u043D\u044B \u0438\u043B\u0438 \u0438\u043D\u044B\u043C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u043C, \u0438\u043C\u0435\u044E\u0449\u0438\u043C \u043F\u0440\u0430\u0432\u043E \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0442\u044C \u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u0443 (\u0437\u0430\u0449\u0438\u0442\u0443); \uF0FC \u043E\u0445\u0440\u0430\u043D\u0430 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0445 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0443 \u043D\u0430 \u043F\u0440\u0430\u0432\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u0438\u043D\u043E\u043C \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0441 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0435\u043C \u043C\u0435\u0440 \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u044B\u043C\u0438 \u0433\u0440\u0443\u043F\u043F\u0430\u043C\u0438 \u043E\u0445\u0440\u0430\u043D\u044B. \u0418\u041B\u0418 \u2022 \u0443\u0447\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0438/\u0438\u043B\u0438 \u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435 \u0438/\u0438\u043B\u0438 \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043D\u043E \u0438 \u043F\u0440\u0430\u0432\u043E\u0432\u044B\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0449\u0438\u0445 \u043F\u0440\u0430\u0432\u043E\u043C\u043E\u0447\u0438\u0435 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430 \u0437\u0430\u043A\u0443\u043F\u043A\u0438 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0442\u044C \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u043E \u043E\u0445\u0440\u0430\u043D\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0434\u043B\u044F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0438\u0439 \u043D\u0430 \u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u0443\u0433 (\u0434\u043B\u044F \u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u044B \u0438 \u0432\u043D\u0435\u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u044B). * \u0412\u043C\u0435\u0441\u0442\u043E \u043A\u043E\u043F\u0438\u0438 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 \u0438\u043B\u0438 \u0432\u044B\u043F\u0438\u0441\u043A\u0438 \u0438\u0437 \u0440\u0435\u0435\u0441\u0442\u0440\u0430 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A \u0437\u0430\u043A\u0443\u043F\u043A\u0438 \u0432\u043F\u0440\u0430\u0432\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u044B \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 (\u0434\u0430\u0442\u0430 \u0432\u044B\u0434\u0430\u0447\u0438 \u0438 \u043D\u043E\u043C\u0435\u0440).",
    "\u041C\u0435\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0442\u043E\u0432\u0430\u0440\u0430, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0438\u043B\u0438 \u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0443\u0441\u043B\u0443\u0433\u0438": "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0430\u044F \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044F, \u043A\u0440\u0430\u0439 \u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, 1. \u0433. \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A-\u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, \u043F\u0440-\u0442 \u041A\u0430\u0440\u043B\u0430 \u041C\u0430\u0440\u043A\u0441\u0430, \u0434. 29/1, 2 \u044D\u0442\u0430\u0436; 2. \u0433. \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A-\u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, \u043F\u0440-\u0442 \u041A\u0430\u0440\u043B\u0430 \u041C\u0430\u0440\u043A\u0441\u0430, \u0434. 29/1, 3 \u044D\u0442\u0430\u0436; 3. \u0433. \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A-\u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, \u043F\u0440-\u0442 \u041A\u0430\u0440\u043B\u0430 \u041C\u0430\u0440\u043A\u0441\u0430, \u0434. 29/1, 4 \u044D\u0442\u0430\u0436; 4. \u0433. \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A-\u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, \u0443\u043B. \u041E\u043A\u0435\u0430\u043D\u0441\u043A\u0430\u044F, \u0434. 64\u0430; 5. \u0433. \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A-\u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, \u0443\u043B. \u0417\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u0430\u044F, \u0434. 50; 6. \u0433. \u041F\u0435\u0442\u0440\u043E\u043F\u0430\u0432\u043B\u043E\u0432\u0441\u043A-\u041A\u0430\u043C\u0447\u0430\u0442\u0441\u043A\u0438\u0439, \u0443\u043B. \u041B\u0430\u0440\u0438\u043D\u0430, 22/8.",
    "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430": "\u0414\u0430",
    "\u0420\u0430\u0437\u043C\u0435\u0440 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430": "72\u00A0419,04\u00A0\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0440\u0443\u0431\u043B\u044C (10\u00A0%)",
    "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430, \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044E": "\u0418\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430 \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0439 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0438 (\u0434\u0430\u043B\u0435\u0435-\u041D\u0413), \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C \u0441\u0442.45 \u0417\u0430\u043A\u043E\u043D\u0430 \u211644-\u0424\u0417, \u0438\u043B\u0438 \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u0435\u043C \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u0432 \u0438\u0437\u0432\u0435\u0449\u0435\u043D\u0438\u0438 \u0441\u0447\u0435\u0442 \u0441 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435\u043C \u0432 \u043F\u043B\u0430\u0442\u0435\u0436\u043D\u043E\u043C \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0438 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u043F\u043B\u0430\u0442\u0435\u0436\u0430: \u00AB[\u043A\u043E\u0434 \u0418\u041A\u0417]//\u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430\u00BB.\u0421\u043F\u043E\u0441\u043E\u0431 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430 (\u0434\u0430\u043B\u0435\u0435-\u041E\u0418\u041A), \u0441\u0440\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u041D\u0413 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F \u0432 \u0441\u043E\u043E\u0442\u0432. \u0441 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438 \u0417\u0430\u043A\u043E\u043D\u0430 \u211644-\u0424\u0417 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u0437\u0430\u043A\u0443\u043F\u043A\u0438 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.\u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u0441\u0440\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u041D\u0413 \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u043E\u043C \u0441\u0440\u043E\u043A \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u044B \u0442\u0430\u043A\u043E\u0439 \u041D\u0413, \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u0447\u0435\u043C \u043D\u0430 1 \u043C\u0435\u0441\u044F\u0446, \u0432 \u0442.\u0447. \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0435\u0433\u043E \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0441\u043E\u043E\u0442\u0432. \u0441\u043E \u0441\u0442.95 \u0417\u0430\u043A\u043E\u043D\u0430 \u211644-\u0424\u0417. \u0422\u0438\u043F\u043E\u0432\u0430\u044F \u0444\u043E\u044