043D\u0430 \u043E \u043F\u0440\u0438\u043D\u044F\u0442\u043E\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0438 \u0438\u043B\u0438 \u0438\u043D\u044B\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u043C, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u043C \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F \u043D\u0430\u043B\u0438\u0447\u0438\u044F \u0443 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430 \u0437\u0430\u043A\u0443\u043F\u043A\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043D\u0430 \u043F\u0440\u0430\u0432\u043E \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 (\u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438), \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0435\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 (\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F, \u043D\u0435 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430, \u043D\u0435 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E, \u043D\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0435\u043D\u0430).",
