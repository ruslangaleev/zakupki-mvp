    "\u041C\u0435\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0442\u043E\u0432\u0430\u0440\u0430, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0438\u043B\u0438 \u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0443\u0441\u043B\u0443\u0433\u0438": "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0430\u044F \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044F, \u043A\u0440\u0430\u0439 \u0417\u0430\u0431\u0430\u0439\u043A\u0430\u043B\u044C\u0441\u043A\u0438\u0439, \u043C.\u043E. \u0423\u043B\u0451\u0442\u043E\u0432\u0441\u043A\u0438\u0439, \u0441. \u0423\u043B\u0451\u0442\u044B, \u0443\u043B. \u0413\u043E\u0440\u044C\u043A\u043E\u0433\u043E, \u0437\u0434. 74, \u0417\u0430\u0431\u0430\u0439\u043A\u0430\u043B\u044C\u0441\u043A\u0438\u0439 \u043A\u0440\u0430\u0439, \u0441. \u0423\u043B\u0451\u0442\u044B, \u0443\u043B. \u0413\u043E\u0440\u044C\u043A\u043E\u0433\u043E, 74",
    "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430": "\u0414\u0430",
