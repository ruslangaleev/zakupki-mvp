{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Search": {
    "OpenSearchUrl": "http://localhost:9200",
    "EmbeddingsUrl": "http://localhost:8090",
    "EmbeddingDimensions": 384,
    "OrdersIndex": "zakupki-orders",
    "ChunksIndex": "zakupki-chunks",
    "DefaultLimit": 20,
    "MaxLimit": 50
  },
  "Orders": {
    "DataPath": "../../data/orders"
  },
  "Analytics": {
    "DataPath": "../../data/analytics"
  },
  "Review": {
    "OperatorKey": "dev-review-key"
  },
  "Classification": {
    "AutoThreshold": 0.65,
    "L1ModelPath": "../../models/l1.zip"
  }
}
